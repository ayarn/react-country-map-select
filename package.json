{
  "name": "react-country-map-select",
  "version": "0.1.1",
  "description": "Accessible React dropdown selector for countries with their map SVG icons.",
  "keywords": [
    "react",
    "country",
    "countries",
    "country-picker",
    "country-select",
    "map",
    "select",
    "dropdown",
    "combobox",
    "picker",
    "svg",
    "iso-3166",
    "flags",
    "accessibility",
    "a11y",
    "typescript"
  ],
  "license": "MIT",
  "author": "ayarn",
  "homepage": "https://ayarn.github.io/react-country-map-select/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayarn/react-country-map-select.git"
  },
  "bugs": {
    "url": "https://github.com/ayarn/react-country-map-select/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "import": "./dist/maps/index.js",
      "require": "./dist/maps/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-DATA.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node scripts/build-svgs.mjs && node scripts/generate-types.mjs",
    "build": "npm run prebuild && tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\" && node scripts/add-use-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "downshift": "^9.0.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.10.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "svgo": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}